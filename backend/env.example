# ============================================================================
# LOKAL / DOCKER COMPOSE — nilai default ini sudah cocok dengan docker-compose.yml,
# tidak perlu diubah untuk `docker compose up`.
# ============================================================================
DB_NAME=antrigo
DB_USER=antrigo
DB_PASSWORD=antrigo123
MYSQL_ROOT_PASSWORD=root12345
JWT_SECRET=antrigo-super-secret-key-change-in-production-min-256-bits-long
JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=http://localhost:5173
AVG_PREP_MINUTES=4
CHECKOUT_RATE_LIMIT=20
SEED_DEMO_DATA=true
QRIS_EXPIRY_MINUTES=15
QRIS_EXPIRY_SWEEP_MS=60000

# --- Midtrans (wajib diisi biar RealMidtransGatewayService aktif, bukan dummy) ---
# Ambil dari Midtrans Dashboard > Settings > Access Keys (mode SANDBOX, bukan Production).
# File ini (backend/.env) sekarang auto-ke-load oleh spring-dotenv walau kamu run
# `mvn spring-boot:run` langsung di terminal / lewat IDE, tanpa Docker.
MIDTRANS_SERVER_KEY=YOUR_KEY_HERE
MIDTRANS_CLIENT_KEY=YOUR_KEY_HERE
MIDTRANS_MERCHANT_ID=YOUR_KEY_HERE
MIDTRANS_SANDBOX=true

# ============================================================================
# PRODUKSI (Render/Koyeb + Aiven for MySQL + Upstash Redis) — isi nilai di
# dashboard masing-masing platform, JANGAN commit nilai asli ke git.
# ============================================================================

# --- Backend web service (Render/Koyeb) ---
# PORT           # jangan set manual di Render — platform yang inject otomatis
# SPRING_PROFILES_ACTIVE=docker

# --- Aiven for MySQL ---
# Ambil dari tab "Overview" service Aiven: Host, Port, User, Password, Database name.
# DB_HOST=<service>.aivencloud.com
# DB_PORT=<port dari Aiven, bukan 3306>
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=<password dari Aiven>
# DB_SSL_MODE=REQUIRED        # WAJIB — Aiven menolak koneksi tanpa TLS
# DB_POOL_SIZE=5              # default sudah 5 (dulu 10), instance free tier Aiven/Railway kecil

# Cache sekarang in-memory (Caffeine), tidak butuh Redis/Upstash lagi —
# tidak ada env var tambahan yang perlu di-set untuk cache.

# --- CORS ---
# Origin persis (scheme + host, TANPA trailing slash), pisahkan dengan koma kalau lebih
# dari satu domain (mis. custom domain + preview). Harus https karena Vercel serve via HTTPS.
# CORS_ORIGINS=https://antrigo.vercel.app

# --- Keamanan ---
# JWT_SECRET=<generate string acak minimal 32 karakter, jangan pakai nilai default di atas>
