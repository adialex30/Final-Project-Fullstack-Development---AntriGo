{
  "info": {
    "name": "AntriGo API",
    "description": "Self-Order & Antrean Digital untuk warung/UMKM — Spring Boot backend. Base URL production: https://antrigo-be.up.railway.app",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://antrigo-be.up.railway.app/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "orderNumber", "value": "ORD-20260822-EXAMPLE", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" },
    { "key": "categoryId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@antrigo.id\",\n  \"password\": \"Admin12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Staff/Admin (admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Staff Baru\",\n  \"email\": \"staff.baru@antrigo.id\",\n  \"password\": \"Staff12345\",\n  \"role\": \"STAFF\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Public — Menu",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "List Products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "search", "value": "", "disabled": true },
                { "key": "category", "value": "{{categoryId}}", "disabled": true },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Product Detail",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Public — Orders & Payment",
      "item": [
        {
          "name": "Checkout (create order)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": \"07\",\n  \"customerName\": \"Santoso\",\n  \"customerPhone\": \"081234567890\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"variantId\": null,\n      \"quantity\": 2,\n      \"note\": \"pedas sedang\"\n    }\n  ],\n  \"paymentMethod\": \"QRIS\",\n  \"note\": \"tanpa bawang\"\n}"
            }
          }
        },
        {
          "name": "Get Order Detail",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderNumber}}"
          }
        },
        {
          "name": "Get Order Status (polling)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderNumber}}/status"
          }
        },
        {
          "name": "Confirm QRIS Payment (manual check)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{baseUrl}}/orders/{{orderNumber}}/payments/qris/confirm"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderNumber}}/cancel?reason=Berubah pikiran",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderNumber}}", "cancel"],
              "query": [{ "key": "reason", "value": "Berubah pikiran" }]
            }
          }
        },
        {
          "name": "Midtrans Payment Notification (webhook)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/payments/midtrans/notification",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"{{orderNumber}}\",\n  \"transaction_status\": \"settlement\",\n  \"status_code\": \"200\",\n  \"gross_amount\": \"20000.00\",\n  \"signature_key\": \"<dihasilkan Midtrans>\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin/Staff — Kitchen & Orders",
      "item": [
        {
          "name": "Kitchen Board (Papan Dapur)",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/orders/board" }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/orders/{{orderNumber}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PROCESSING\",\n  \"note\": \"Sedang dimasak\"\n}"
            }
          }
        },
        {
          "name": "Confirm Cash Payment",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/admin/orders/{{orderNumber}}/payment/confirm" }
        }
      ]
    },
    {
      "name": "Admin — Products & Categories",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"name\": \"Nasi Goreng Spesial\",\n  \"description\": \"Nasi goreng dengan telur, ayam suwir, dan acar\",\n  \"price\": 22000,\n  \"stock\": 40,\n  \"imageUrl\": null,\n  \"active\": true\n}"
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"name\": \"Nasi Goreng Spesial\",\n  \"description\": \"Update deskripsi\",\n  \"price\": 23000,\n  \"stock\": 35,\n  \"imageUrl\": null,\n  \"active\": true\n}"
            }
          }
        },
        {
          "name": "Deactivate Product (admin only)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/products/{{productId}}" }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Camilan\",\n  \"sortOrder\": 3\n}"
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/categories/{{categoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Camilan & Snack\",\n  \"sortOrder\": 3\n}"
            }
          }
        },
        {
          "name": "Delete Category (admin only)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/admin/categories/{{categoryId}}" }
        }
      ]
    },
    {
      "name": "Admin — Stock",
      "item": [
        {
          "name": "Adjust Stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/stock/{{productId}}/adjust",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChange\": 10,\n  \"note\": \"Restock dari supplier\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin — Reports (admin only)",
      "item": [
        {
          "name": "Dashboard Summary",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/reports/dashboard" }
        },
        {
          "name": "Low Stock Report",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/reports/low-stock" }
        }
      ]
    }
  ]
}
