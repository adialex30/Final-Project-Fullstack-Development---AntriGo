# ============================================================================
# JVM tuning — Antrigo backend di Railway Free Tier (target: container 512MB)
# Set semua ini di Railway Dashboard > project > Variables.
# JAVA_TOOL_OPTIONS di sini akan OVERRIDE nilai default yang di-hardcode di
# Dockerfile — gak perlu rebuild image tiap kali mau ubah tuning.
# ============================================================================

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=40.0 -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=32m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss384k -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Jakarta -Djava.security.egd=file:/dev/./urandom

# --- Batasi Tomcat thread pool (mencegah 200 thread default × stack size
#     jadi beban gak perlu di instance 0.5-1 vCPU) ---
SERVER_TOMCAT_THREADS_MAX=20
SERVER_TOMCAT_THREADS_MIN_SPARE=4
SERVER_TOMCAT_MAX_CONNECTIONS=100
SERVER_TOMCAT_ACCEPT_COUNT=20

# --- Matikan Swagger UI di production (hemat metaspace dari reflection
#     scanning saat startup + kurangi attack surface) ---
SWAGGER_ENABLED=false

# --- HikariCP: nilai default (5) di application.yml sudah konservatif dan
#     dikontrol via env var ini kalau perlu diturunkan lagi ---
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=2
